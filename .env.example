# --- Supabase ---
# Från Supabase-projektet: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (ENDAST server-side: ingest, scoring, admin). Läggs ALDRIG i klienten.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- swehockey ---
# Säsongs-ID för HockeyAllsvenskan (finns i schema-URL:en på stats.swehockey.se, t.ex. .../Schedule/XXXX)
SWEHOCKEY_SEASON_ID=
# swehockey lag-ID för Södertälje SK
SWEHOCKEY_TEAM_ID=

# --- Cron/ingest säkerhet ---
# Slumpad hemlig sträng. Cron-anrop måste skicka den som ?secret= eller Authorization: Bearer.
CRON_SECRET=change-me-to-a-long-random-string

# --- Mejl (Resend) — för notiser inför omgångar ---
RESEND_API_KEY=
EMAIL_FROM=SSK-femman <noreply@sskfemman.se>

# --- App ---
# Lokalt: http://localhost:3000 · I produktion: https://sskfemman.se
NEXT_PUBLIC_SITE_URL=http://localhost:3000
